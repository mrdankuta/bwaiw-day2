[{"cuisine":"Nigerian","difficulty":"Medium","id":"jollof-rice","imageUrl":"","ingredients":["rice","tomato","red bell pepper","onion","vegetable oil","salt","chicken stock","curry","thyme"],"regions":["Nigeria","West-Africa"],"servings":4,"steps":["Blend tomato, pepper and onion.","Fry paste in oil 10 min.","Add stock, curry, thyme, salt; bring to boil.","Stir in rice, cover and cook 25 min. Rest 5 min."],"timeMinutes":60,"title":"Jollof Rice"},{"cuisine":"Nigerian","difficulty":"Medium","id":"fried-rice","imageUrl":"","ingredients":["rice","carrot","green peas","sweet corn","onion","vegetable oil","salt","chicken stock","curry"],"regions":["Nigeria","West-Africa","Global"],"servings":4,"steps":["Parboil rice 10 min; drain.","Stir-fry onion, carrot, peas, corn 5 min.","Add rice, stock, curry, salt; fry 10 min."],"timeMinutes":45,"title":"Nigerian Fried Rice"},{"cuisine":"Nigerian","difficulty":"Hard","id":"egusi-soup","imageUrl":"","ingredients":["egusi seeds","palm oil","spinach","beef","stockfish","onion","salt","pepper","water"],"regions":["Nigeria","West-Africa"],"servings":6,"steps":["Boil beef and stockfish with onion and salt.","Stir ground egusi into palm oil; fry 5 min.","Add meat, stock, water; simmer 20 min.","Fold in spinach; cook 5 min."],"timeMinutes":60,"title":"Egusi Soup"},{"cuisine":"Nigerian","difficulty":"Medium","id":"ogbono-soup","imageUrl":"","ingredients":["ogbono seeds","palm oil","ugu leaves","beef","stockfish","onion","salt","pepper","water"],"regions":["Nigeria","West-Africa"],"servings":6,"steps":["Boil beef with onion and salt.","Dissolve ground ogbono in palm oil over heat.","Add stock and water; simmer 20 min.","Add ugu; cook 5 min."],"timeMinutes":55,"title":"Ogbono Soup"},{"cuisine":"Nigerian","difficulty":"Easy","id":"okra-soup","imageUrl":"","ingredients":["okra","palm oil","spinach","beef","onion","salt","pepper","water"],"regions":["Nigeria","West-Africa"],"servings":4,"steps":["Boil beef with onion, salt.","Add chopped okra; cook 8 min.","Stir in palm oil and spinach; cook 5 min."],"timeMinutes":40,"title":"Okra Soup"},{"cuisine":"Nigerian","difficulty":"Medium","id":"efo-riro","imageUrl":"","ingredients":["spinach","palm oil","beef","smoked fish","pepper","onion","salt","water"],"regions":["Nigeria","West-Africa"],"servings":4,"steps":["Boil beef with onion and salt.","Fry pepper in palm oil 5 min.","Add meat, fish, water; simmer 10 min.","Fold in spinach; cook 5 min."],"timeMinutes":45,"title":"Efo Riro"},{"cuisine":"Nigerian","difficulty":"Easy","id":"beans-porridge","imageUrl":"","ingredients":["brown beans","palm oil","onion","pepper","salt","water"],"regions":["Nigeria","West-Africa"],"servings":4,"steps":["Boil beans until soft, ~40 min.","Add palm oil, onion, pepper, salt.","Simmer 10 min until creamy."],"timeMinutes":60,"title":"Beans Porridge"},{"cuisine":"Nigerian","difficulty":"Medium","id":"moi-moi","imageUrl":"","ingredients":["beans","red bell pepper","onion","vegetable oil","salt","eggs","water"],"regions":["Nigeria","West-Africa"],"servings":6,"steps":["Soak and peel beans; blend with pepper and onion.","Mix in oil, salt, water to thick batter.","Pour into cups with egg slices; steam 45 min."],"timeMinutes":60,"title":"Moi Moi"},{"cuisine":"Nigerian","difficulty":"Easy","id":"akara","imageUrl":"","ingredients":["beans","onion","pepper","salt","vegetable oil","water"],"regions":["Nigeria","West-Africa"],"servings":4,"steps":["Soak, peel and blend beans thick.","Season with onion, pepper, salt.","Deep-fry spoonfuls until golden."],"timeMinutes":30,"title":"Akara"},{"cuisine":"Nigerian","difficulty":"Easy","id":"yam-porridge","imageUrl":"","ingredients":["yam","palm oil","spinach","onion","pepper","salt","water"],"regions":["Nigeria","West-Africa"],"servings":4,"steps":["Cube yam; boil with salted water 15 min.","Add palm oil, pepper, onion; simmer 10 min.","Fold in spinach; cook 3 min."],"timeMinutes":35,"title":"Yam Porridge"},{"cuisine":"Nigerian","difficulty":"Easy","id":"fried-yam-egg","imageUrl":"","ingredients":["yam","eggs","onion","tomato","pepper","vegetable oil","salt"],"regions":["Nigeria","West-Africa"],"servings":2,"steps":["Slice yam; fry until golden.","Sauté onion, tomato, pepper 5 min.","Scramble in eggs; serve over yam."],"timeMinutes":30,"title":"Fried Yam with Egg Sauce"},{"cuisine":"Nigerian","difficulty":"Easy","id":"plantain-egg","imageUrl":"","ingredients":["plantain","eggs","onion","tomato","pepper","vegetable oil","salt"],"regions":["Nigeria","West-Africa"],"servings":2,"steps":["Fry plantain slices until golden.","Sauté onion, tomato, pepper.","Scramble eggs in; serve together."],"timeMinutes":25,"title":"Fried Plantain with Eggs"},{"cuisine":"Fusion","difficulty":"Easy","id":"spaghetti-jollof","imageUrl":"","ingredients":["spaghetti","tomato","onion","vegetable oil","salt","curry","thyme","chicken stock"],"regions":["Nigeria","West-Africa","Global"],"servings":3,"steps":["Fry blended tomato and onion 8 min.","Add stock, curry, thyme, salt.","Break in spaghetti; cook until tender."],"timeMinutes":35,"title":"Jollof Spaghetti"},{"cuisine":"Nigerian","difficulty":"Medium","id":"chicken-stew-rice","imageUrl":"","ingredients":["chicken","rice","tomato","red bell pepper","onion","vegetable oil","salt","curry","thyme"],"regions":["Nigeria","West-Africa"],"servings":4,"steps":["Boil chicken with onion, salt; reserve stock.","Fry blended tomato mix 12 min.","Add chicken + stock; simmer 15 min. Serve over rice."],"timeMinutes":60,"title":"Chicken Stew with Rice"},{"cuisine":"Nigerian","difficulty":"Easy","id":"beef-pepper-soup","imageUrl":"","ingredients":["beef","pepper soup spice","onion","salt","scent leaves","water"],"regions":["Nigeria","West-Africa"],"servings":4,"steps":["Boil beef with onion and salt 25 min.","Add spice and water; simmer 15 min.","Add scent leaves; rest 5 min."],"timeMinutes":45,"title":"Beef Pepper Soup"},{"cuisine":"Nigerian","difficulty":"Medium","id":"catfish-pepper-soup","imageUrl":"","ingredients":["catfish","pepper soup spice","onion","salt","scent leaves","water"],"regions":["Nigeria","West-Africa"],"servings":3,"steps":["Bring salted water, onion, spice to boil.","Add fish gently; simmer 12 min.","Add scent leaves; serve hot."],"timeMinutes":30,"title":"Catfish Pepper Soup"},{"cuisine":"Nigerian","difficulty":"Easy","id":"suya","imageUrl":"","ingredients":["beef","suya spice","vegetable oil","salt","onion","tomato"],"regions":["Nigeria","West-Africa"],"servings":4,"steps":["Slice beef thin; coat in spice and oil.","Grill 10 min, turning once.","Serve with onion and tomato."],"timeMinutes":25,"title":"Suya"},{"cuisine":"Middle-Eastern","difficulty":"Medium","id":"shawarma","imageUrl":"","ingredients":["chicken","shawarma bread","cabbage","carrot","mayonnaise","ketchup","onion","salt","spices"],"regions":["Nigeria","Global"],"servings":3,"steps":["Spice and grill chicken; slice.","Mix veg with mayo and ketchup.","Wrap in warmed bread."],"timeMinutes":40,"title":"Homemade Shawarma"},{"cuisine":"Global","difficulty":"Easy","id":"pancakes","imageUrl":"","ingredients":["flour","eggs","milk","sugar","salt","butter","water"],"regions":["Global","Nigeria"],"servings":4,"steps":["Whisk flour, eggs, milk, sugar, salt.","Rest batter 5 min.","Fry thin rounds in buttered pan."],"timeMinutes":20,"title":"Pancakes"},{"cuisine":"Global","difficulty":"Easy","id":"omelette","imageUrl":"","ingredients":["eggs","onion","tomato","pepper","salt","vegetable oil"],"regions":["Global","Nigeria"],"servings":1,"steps":["Beat eggs with salt.","Sauté onion, tomato, pepper 3 min.","Pour eggs; fold when set."],"timeMinutes":15,"title":"Veggie Omelette"},{"cuisine":"Global","difficulty":"Easy","id":"egg-bread","imageUrl":"","ingredients":["eggs","bread","butter","salt","pepper"],"regions":["Global","Nigeria"],"servings":1,"steps":["Butter bread; toast lightly.","Fry or scramble eggs with salt.","Assemble and serve."],"timeMinutes":10,"title":"Fried Eggs with Bread"},{"cuisine":"Italian","difficulty":"Easy","id":"tomato-pasta","imageUrl":"","ingredients":["pasta","tomato","garlic","onion","vegetable oil","salt","black pepper"],"regions":["Global"],"servings":3,"steps":["Boil pasta until al dente.","Sauté garlic and onion; add tomato 8 min.","Toss pasta through sauce."],"timeMinutes":25,"title":"Tomato Garlic Pasta"},{"cuisine":"Global","difficulty":"Easy","id":"garlic-butter-rice","imageUrl":"","ingredients":["rice","garlic","butter","salt","black pepper","water"],"regions":["Global","Nigeria"],"servings":3,"steps":["Cook rice; keep hot.","Melt butter; fry garlic golden.","Toss rice with garlic butter."],"timeMinutes":25,"title":"Garlic Butter Rice"},{"cuisine":"Chinese","difficulty":"Medium","id":"veg-stir-fry","imageUrl":"","ingredients":["cabbage","carrot","green beans","soy sauce","garlic","vegetable oil","salt","rice"],"regions":["Global","Nigeria"],"servings":3,"steps":["Slice veg thin.","Stir-fry garlic then veg 6 min.","Splash soy sauce; serve over rice."],"timeMinutes":30,"title":"Vegetable Stir Fry with Rice"},{"cuisine":"Global","difficulty":"Medium","id":"chicken-fried-rice","imageUrl":"","ingredients":["rice","chicken","carrot","green peas","soy sauce","onion","vegetable oil","salt","eggs"],"regions":["Global","Nigeria"],"servings":4,"steps":["Cook rice a day ahead or chill.","Stir-fry chicken; set aside.","Fry veg, eggs, rice with soy sauce; return chicken."],"timeMinutes":45,"title":"Chicken Fried Rice"},{"cuisine":"Global","difficulty":"Easy","id":"tuna-sandwich","imageUrl":"","ingredients":["tuna","bread","mayonnaise","onion","tomato","salt","black pepper"],"regions":["Global"],"servings":2,"steps":["Drain tuna; mix with mayo, onion.","Season with salt and pepper.","Fill bread with tomato slices."],"timeMinutes":10,"title":"Tuna Sandwich"},{"cuisine":"Nigerian","difficulty":"Easy","id":"beans-plantain","imageUrl":"","ingredients":["brown beans","plantain","palm oil","onion","pepper","salt","water"],"regions":["Nigeria","